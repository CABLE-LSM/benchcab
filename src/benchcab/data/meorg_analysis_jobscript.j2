#!/bin/bash
#PBS -l wd
#PBS -l ncpus={{ncpus}}
#PBS -l mem={{mem}}
#PBS -l walltime={{walltime}}
#PBS -q normal
#PBS -P {{project}}
#PBS -j oe
#PBS -m e
#PBS -l storage={{storage_str}}

set -ev

module purge
module use {{meorg_module_use}}
module load {{meorg_module}}
export MEORG_MODULE={{meorg_module}} MEORG_RUN_ID={{run_id}}

# meorg-run writes run.json for a failed analysis too, then exits 1.
# Carry on, so that the result job submits the failure to me.org.
meorg-run --input {{run_dir}}/input.json --run-dir {{run_dir}} || echo "meorg-run failed, see {{run_dir}}/run.json"
